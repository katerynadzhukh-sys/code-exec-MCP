{
  "name": "code-exec-mcp",
  "version": "1.0.0",
  "description": "MCP server that executes Python code in an isolated gVisor sandbox",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "start:stdio": "node dist/index.js --transport=stdio",
    "start:http": "node dist/index.js --transport=http"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sandbox",
    "gvisor",
    "python"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
